# Copy to .env on the server and fill in (chmod 600). Never commit the real .env.
# ~/bgc-db (this compose) and ~/bgc-api (deploy.sh runs docker compose --env-file ../bgc-db/.env) both read this file.
POSTGRES_PASSWORD=   # openssl rand -hex 24  (hex only: it goes inside NocoDB's connection URL)
NC_JWT_SECRET=       # openssl rand -hex 32
BACKUP_REPO=git@github.com:daddo78/bgc-backups.git

# Used by the API only (bgc-api/docker-compose.yml); the database containers ignore them
# OPENROUTER_API_KEY=   # Nathan's models via OpenRouter (openrouter.ai keys); required for the API to answer questions
# BGG_TOKEN=            # BoardGameGeek API token for collection and plays reads; optional, without it BGG calls are unauthenticated
# RESEND_API_KEY=       # Resend (resend.com) key for the emails the API sends (feedback, alerts); optional, no emails without it
